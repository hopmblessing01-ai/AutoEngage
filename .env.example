# Contact form (Resend) — https://resend.com
# Set the real key in Netlify → Environment variables (never commit it here).
RESEND_API_KEY=

# INBOX: where you receive form submissions
CONTACT_TO_EMAIL=hopmblessing@gmail.com

# Optional sender. Leave unset to use onboarding@resend.dev (works without domain verification).
# Only set a custom address after verifying your domain in Resend, then set RESEND_DOMAIN_VERIFIED=true.
# CONTACT_FROM_EMAIL=AutoEngage <hello@autoengage.uk.com>
# RESEND_DOMAIN_VERIFIED=true

# Optional: Google Search Console
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code
